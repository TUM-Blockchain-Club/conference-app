root = true

[*.{kt,kts}]
# intellij_idea (not ktlint_official) matches gradle.properties'
# kotlin.code.style=official and the existing Android Studio-written code, so
# the ratchet has as little to rewrite as possible.
ktlint_code_style = intellij_idea
max_line_length = 120
# The three rules below all report violations ktlint cannot auto-fix, so leaving
# any of them on would break `spotlessApply`, not just `spotlessCheck`.
#
# function-naming: Composables are PascalCase, repo-wide.
# property-naming: so are private compile-time constants naming design tokens
#   (`ViewportSize`, `MinZoom`) — the Compose convention, not SCREAMING_SNAKE.
# kdoc: several files open with a dangling file-level KDoc block documenting the
#   file as a whole (ui/theme/Palette.kt, ui/map/MapGeometry.kt, …).
ktlint_standard_function-naming = disabled
ktlint_standard_property-naming = disabled
ktlint_standard_kdoc = disabled
