<?xml version="1.0" encoding="utf-8"?>
<!--
  Dev-only: allows plain HTTP to a locally running Supabase instance (`supabase start`).
  127.0.0.1 is reached through `adb reverse tcp:54321 tcp:54321`, which `make android-run`
  sets up and which works on physical devices as well as emulators; 10.0.2.2 is the
  emulator-only alias for the host loopback, kept for anyone not using adb reverse.
  Does not affect requests to the real (HTTPS) Supabase project.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
