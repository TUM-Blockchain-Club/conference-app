<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Push Notifications capability. Can only be code-signed for a device by a
	  team enrolled in the Apple Developer Program with Push enabled for
	  com.conference.asmara; until then device registration fails at runtime
	  (harmlessly — see AppDelegate). Switch to "production" for App Store
	  builds.
	-->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
